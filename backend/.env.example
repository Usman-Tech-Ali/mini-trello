# Copy to backend/.env and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Must point to a replica set: writes use multi-document transactions.
# A single-node replica set is enough for local development (see README).
MONGODB_URI=mongodb://127.0.0.1:27017/mini-trello?replicaSet=rs0

# Comma-separated list of exact browser origins allowed to call the API (CORS + CSRF origin check).
CORS_ORIGINS=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Secret used to sign session tokens (JWT, HS256). Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Session cookie. Local dev over http: leave COOKIE_SECURE unset (defaults to true only in production).
# Cross-site production deployments need COOKIE_SAME_SITE=none and COOKIE_SECURE=true.
# COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# Max auth attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=20

# Optional: also write JSON logs to this file (relative to backend/). Useful for reviewing a
# manual test session; browser errors are added to it in development. Clear with: npm run logs:clear
# LOG_FILE=../logs/dev.log
