# Copy to frontend/.env.local and adjust. Never commit real .env files.

# Base URL of the Express API (no trailing slash). Exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# true: the browser calls this site's /api/* and Next.js forwards it to NEXT_PUBLIC_API_URL, so the
# session cookie is first-party. Use when the web app and API are on different sites (e.g. Vercel +
# Render); then set COOKIE_SAME_SITE=lax on the API. Socket.IO still connects to the API directly.
NEXT_PUBLIC_API_PROXY=false
